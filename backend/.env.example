NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/nosa

# Comma separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3100

# Next.js on-demand revalidation (must match frontend REVALIDATE_SECRET)
FRONTEND_URL=http://localhost:3100
REVALIDATE_SECRET=change-me

# At least 32 random characters
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# Sent by cron-job.org in the x-cron-secret header
CRON_SECRET=change-me-change-me

# Optional until the accounts exist (features answer 503 without them)
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used by `npm run seed` to create the owner account
SEED_OWNER_NAME=Nosa Owner
SEED_OWNER_PHONE=01000000000
SEED_OWNER_PASSWORD=change-me-now
